---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found - Jonathan Witherspoon"
  description="The page you asked for does not exist. Use the links to find your way."
  path="/404.html"
>
  <header class="page-header">
    <h1 id="page-title">Page not found</h1>
    <p class="intro">That address does not lead anywhere. Try one of these instead.</p>
  </header>
  <ul class="plain-list">
    <li><a href="/">Home</a></li>
    <li><a href="/portfolio/">Portfolio</a></li>
    <li><a href="/projects/">Projects</a></li>
    <li><a href="/labs/">Labs</a></li>
  </ul>
</Base>
