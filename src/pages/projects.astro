---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const projects = [...site.projects].sort((a, b) => a.order - b.order || b.date.localeCompare(a.date));
---

<Base
  title="Projects - Jonathan Witherspoon"
  description="Selected automation and tooling projects by Jonathan Witherspoon: PowerShell frameworks, a Windows Event Log triage tool, and a self-hosted finance app."
  path="/projects/"
  section="projects"
>
  <header class="page-header">
    <h1 id="page-title">Projects</h1>
    <p class="intro">Tools I built to solve real problems. Each card links to the source or release.</p>
  </header>
  <ul class="card-list">
    {projects.map((project) => (
      <li class="card">
        <h2><a href={project.url} rel="noopener noreferrer">{project.title}</a></h2>
        <p>{project.description}</p>
        <p class="tags mono">{project.tags.join(' · ')}</p>
        <p class="meta mono">{project.status} · {project.linkLabel}</p>
      </li>
    ))}
  </ul>
</Base>
