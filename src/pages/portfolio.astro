---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatDate(value: string | null): string {
  if (!value) return '';
  const [year, month, day] = value.split('-');
  const monthName = monthNames[Number(month) - 1] ?? '';
  return [day ? String(Number(day)) : '', monthName, year].filter(Boolean).join(' ');
}

function isPlaceholder(value: string | undefined): boolean {
  return value?.startsWith('[TO SUPPLY') ?? false;
}

const CHIP_TINTS = ['blue', 'teal', 'amber', 'rose'];
function chipTint(label: string): string {
  const total = [...label].reduce((sum, character) => sum + character.charCodeAt(0), 0);
  return CHIP_TINTS[total % CHIP_TINTS.length];
}

const { profile, education } = site;
const educationAreas = education.areas ?? [];
const featuredProjects = site.projects
  .filter((project) => project.featured)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 3);
const socialLinks = [
  { label: 'LinkedIn', href: profile.linkedin },
  { label: 'GitHub', href: profile.github },
  { label: 'Credly', href: profile.credly },
  { label: 'Microsoft Learn', href: profile.learn },
].filter((link) => link.href);
const tabs = [
  { id: 'about', label: 'About' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'certifications', label: 'Certifications' },
  { id: 'education', label: 'Education' },
];
---

<Base
  title="Portfolio - Jonathan Witherspoon"
  description="Portfolio of Jonathan Witherspoon, systems administrator and infrastructure engineer: about, skills, experience, projects, certifications, and education."
  path="/portfolio/"
  section="portfolio"
  withTabs
>
  <section class="hero" aria-labelledby="page-title">
    <img class="avatar" src={profile.avatar} width="96" height="96" alt={`Portrait of ${profile.name}`} />
    <div>
      <h1 id="page-title">{profile.name}</h1>
      <p class="role-line mono">{profile.roleLine}</p>
      <p class="meta">{profile.location}</p>
      <div class="button-row">
        {socialLinks.map((link) => <a class="button button-secondary" href={link.href} rel="noopener noreferrer">{link.label}</a>)}
      </div>
    </div>
  </section>

  <div class="tabs-wrapper">
    <div class="tablist" role="tablist" aria-label="Portfolio sections" data-tablist>
      {tabs.map((tab, index) => (
        <button class="tab" type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'}>{tab.label}</button>
      ))}
    </div>
  </div>

  <section class="tab-panel" id="panel-about" role="tabpanel" aria-labelledby="tab-about">
    <h2 class="block-heading"><span class="mono">01 /</span> About</h2>
    <p class="placeholder">{profile.aboutDraftNote}</p>
    {profile.about.map((paragraph) => <p class="intro">{paragraph}</p>)}
  </section>

  <section class="tab-panel" id="panel-skills" role="tabpanel" aria-labelledby="tab-skills">
    <h2 class="block-heading"><span class="mono">02 /</span> Skills</h2>
    <div class="skill-groups">
      {site.skills.map((group) => (
        <div class="skill-group">
          <h3 class="skill-heading mono">{group.group}</h3>
          <ul class="chips mono">
            {(group.items ?? []).map((item) => <li class={`chip chip-${chipTint(item)}`}>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="tab-panel" id="panel-experience" role="tabpanel" aria-labelledby="tab-experience">
    <h2 class="block-heading"><span class="mono">03 /</span> Experience</h2>
    <ol class="entries">
      {site.experience.map((role) => (
        <li class="entry">
          <p class="entry-dates mono">
            {isPlaceholder(role.start) ? <span class="placeholder">{role.start}</span> : formatDate(role.start)}
            to {role.end === 'present' ? 'present' : formatDate(role.end)}
          </p>
          <div>
            <h3>
              {isPlaceholder(role.title) ? <span class="placeholder">{role.title}</span> : role.title}
              {role.current && <span class="badge mono">current</span>}
            </h3>
            <p class="meta">
              {role.company},{' '}
              {isPlaceholder(role.location) ? <span class="placeholder">{role.location}</span> : role.location}
            </p>
            <ul class="bullets">
              {(role.bullets ?? []).map((bullet) => (
                <li>{isPlaceholder(bullet) ? <span class="placeholder">{bullet}</span> : bullet}</li>
              ))}
            </ul>
            {(role.technologies ?? []).length > 0 && (
              <ul class="chips mono">
                {(role.technologies ?? []).map((technology) => (
                  <li class={isPlaceholder(technology) ? 'chip-placeholder' : `chip chip-${chipTint(technology)}`}>
                    {isPlaceholder(technology) ? <span class="placeholder">{technology}</span> : technology}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="tab-panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects">
    <h2 class="block-heading"><span class="mono">04 /</span> Projects</h2>
    <ul class="card-list">
      {featuredProjects.map((project) => (
        <li class="card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <ul class="chips mono">
            {(project.tags ?? []).map((tag) => <li class={`chip chip-${chipTint(tag)}`}>{tag}</li>)}
          </ul>
          <p class="card-action"><a class="button button-secondary" href={project.url} rel="noopener noreferrer">{project.linkLabel ?? 'Repository'}</a></p>
        </li>
      ))}
    </ul>
    <p class="more"><a class="button button-primary" href="/projects/">See all projects</a></p>
  </section>

  <section class="tab-panel" id="panel-certifications" role="tabpanel" aria-labelledby="tab-certifications">
    <h2 class="block-heading"><span class="mono">05 /</span> Certifications</h2>
    <ul class="cert-list">
      {site.certifications.map((cert) => (
        <li class="cert">
          <p class="meta mono">{cert.issuer}</p>
          <h3>{cert.name}</h3>
          <p class="meta mono">{cert.earned ? `Earned ${formatDate(cert.earned)}` : 'Date not listed'}</p>
          {cert.verifyUrl && <p><a href={cert.verifyUrl} rel="noopener noreferrer">{cert.verifyLabel}</a></p>}
        </li>
      ))}
    </ul>
    <details class="past-exams">
      <summary>Past exams</summary>
      <p class="meta">{site.pastExamsNote}</p>
      <ul class="exam-list">
        {site.pastExams.map((exam) => (
          <li class="exam">
            <h4>{exam.name}</h4>
            <p class="meta mono">{exam.issuer} · Passed {formatDate(exam.passed)} · {exam.format}</p>
            <p>{exam.description}</p>
          </li>
        ))}
      </ul>
    </details>
  </section>

  <section class="tab-panel" id="panel-education" role="tabpanel" aria-labelledby="tab-education">
    <h2 class="block-heading"><span class="mono">06 /</span> Education</h2>
    <div class="education">
      <h3>{education.degree}</h3>
      <p class="meta">{education.school}, {education.detail}</p>
      <p>{education.summary}</p>
      {educationAreas.length > 0 && (
        <ul class="chips mono">
          {educationAreas.map((area) => <li class={`chip chip-${chipTint(area)}`}>{area}</li>)}
        </ul>
      )}
    </div>
  </section>
</Base>
