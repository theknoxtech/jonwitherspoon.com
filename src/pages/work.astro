---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatDate(value: string | null): string {
  if (!value) return '';
  const [year, month, day] = value.split('-');
  const monthName = monthNames[Number(month) - 1] ?? '';
  return [day ? String(Number(day)) : '', monthName, year].filter(Boolean).join(' ');
}

function isPlaceholder(value: string): boolean {
  return value.startsWith('[TO SUPPLY');
}

const { education } = site;
---

<Base
  title="Work - Jonathan Witherspoon"
  description="Career history, skills, certifications, and education of Jonathan Witherspoon, systems administrator and infrastructure engineer."
  path="/work/"
  section="work"
>
  <header class="page-header">
    <h1 id="page-title">Work</h1>
    <p class="intro">{site.profile.location}. Systems administration, infrastructure, and automation.</p>
  </header>

  <section class="block" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="block-heading"><span class="mono">01 /</span> Experience</h2>
    <ol class="entries">
      {site.experience.map((role) => (
        <li class="entry">
          <p class="entry-dates mono">
            {isPlaceholder(role.start) ? <span class="placeholder">{role.start}</span> : formatDate(role.start)}
            to {role.end === 'present' ? 'present' : formatDate(role.end)}
          </p>
          <div>
            <h3>
              {isPlaceholder(role.title) ? <span class="placeholder">{role.title}</span> : role.title}
              {role.current && <span class="badge mono">current</span>}
            </h3>
            <p class="meta">
              {role.company},{' '}
              {isPlaceholder(role.location) ? <span class="placeholder">{role.location}</span> : role.location}
            </p>
            <ul class="bullets">
              {role.bullets.map((bullet) => (
                <li>{isPlaceholder(bullet) ? <span class="placeholder">{bullet}</span> : bullet}</li>
              ))}
            </ul>
            <p class="tags mono">
              {role.technologies.map((technology, index) => (
                <>
                  {index > 0 && ' · '}
                  {isPlaceholder(technology) ? <span class="placeholder">{technology}</span> : technology}
                </>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="block" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="block-heading"><span class="mono">02 /</span> Skills</h2>
    <dl class="skills">
      {site.skills.map((group) => (
        <>
          <dt class="mono">{group.group}</dt>
          <dd>{group.items.join(' · ')}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="block" aria-labelledby="certs-heading">
    <h2 id="certs-heading" class="block-heading"><span class="mono">03 /</span> Certifications</h2>
    <ul class="cert-list">
      {site.certifications.map((cert) => (
        <li class="cert">
          <p class="meta mono">{cert.issuer}</p>
          <h3>{cert.name}</h3>
          <p class="meta mono">{cert.earned ? `Earned ${formatDate(cert.earned)}` : 'Date not listed'}</p>
          {cert.verifyUrl && <p><a href={cert.verifyUrl} rel="noopener noreferrer">{cert.verifyLabel}</a></p>}
        </li>
      ))}
    </ul>
    <h3 class="sub-heading">Past exams</h3>
    <p class="meta">{site.pastExamsNote}</p>
    <ul class="exam-list">
      {site.pastExams.map((exam) => (
        <li class="exam">
          <h4>{exam.name}</h4>
          <p class="meta mono">{exam.issuer} · Passed {formatDate(exam.passed)} · {exam.format}</p>
          <p>{exam.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="education-heading">
    <h2 id="education-heading" class="block-heading"><span class="mono">04 /</span> Education</h2>
    <div class="education">
      <h3>{education.degree}</h3>
      <p class="meta">{education.school}, {education.detail}</p>
      <p>{education.summary}</p>
      <p class="tags mono">{education.areas.join(' · ')}</p>
    </div>
  </section>
</Base>
