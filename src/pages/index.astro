---
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { publishedArticles } from '../lib/articles.js';

const { profile } = site;
const featuredProjects = site.projects
  .filter((project) => project.featured)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 3);
const currentRole = site.experience.find((role) => role.current);
const currentRoleLine = currentRole ? `${currentRole.title} at ${currentRole.company}` : profile.roleLine;
const articles = publishedArticles(await getCollection('blog')).slice(0, 3);
const oneSentenceIntro = `${profile.intro.split('. ')[0].replace(/\.$/, '')}.`;

const CHIP_TINTS = ['blue', 'teal', 'amber', 'rose'];
function chipTint(label: string): string {
  const total = [...label].reduce((sum, character) => sum + character.charCodeAt(0), 0);
  return CHIP_TINTS[total % CHIP_TINTS.length];
}
---

<Base
  title={`${profile.name} - Systems Administrator and Infrastructure Engineer`}
  description={`Jonathan Witherspoon, ${currentRoleLine} in ${profile.location}. Career history, projects, and certification study labs.`}
  path="/"
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-text">
      <h1 id="page-title">Hi, I'm {profile.shortName ?? profile.name}</h1>
      <p class="role-line mono">{currentRoleLine}</p>
      <p class="intro">{oneSentenceIntro}</p>
      <div class="button-row">
        <a class="button button-primary" href="/projects/">View projects</a>
        <a class="button button-primary" href="/portfolio/">Portfolio</a>
      </div>
    </div>
    <ProfileCard />
  </section>

  <section class="block" aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="block-heading"><span class="mono">01 /</span> Articles</h2>
    {articles.length === 0 ? (
      <p class="empty-state">Articles are on the way.</p>
    ) : (
      <ul class="card-list card-list-three">
        {articles.map((article) => (
          <li class="article-card">
            {article.data.cover && <Image class="article-cover" src={article.data.cover} alt={article.data.coverAlt} width={640} height={320} loading="lazy" />}
            <h3>{article.data.title}</h3>
            <p class="meta mono">{article.data.date.toISOString().slice(0, 10)}</p>
            <p>{article.data.description}</p>
            {article.data.tags.length > 0 && (
              <ul class="chips mono">
                {article.data.tags.map((tag) => <li class={`chip chip-${chipTint(tag)}`}>{tag}</li>)}
              </ul>
            )}
            <p class="card-action"><a class="text-link" href={`/articles/${article.id}/`}>Read article<span class="visually-hidden">: {article.data.title}</span></a></p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="block" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="block-heading"><span class="mono">02 /</span> A few projects</h2>
    <ul class="card-list card-list-three">
      {featuredProjects.map((project) => (
        <li class="card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <ul class="chips mono">
            {(project.tags ?? []).map((tag) => <li class={`chip chip-${chipTint(tag)}`}>{tag}</li>)}
          </ul>
          <p class="card-action">
            {(project.links ?? []).map((link) => <a class="text-link" href={link.url} rel="noopener noreferrer" aria-label={`${link.label}: ${project.title}`}>{link.label}</a>)}
          </p>
        </li>
      ))}
    </ul>
    <p class="more"><a class="text-link" href="/projects/">All projects</a></p>
  </section>

  <section class="lab-strip" aria-labelledby="labs-heading">
    <h2 id="labs-heading">Study labs</h2>
    <ul class="strip-items">
      {site.labs.map((lab) => {
        const link = (lab.links ?? []).find((entry) => entry.path);
        return (
          <li>
            {link ? <a class="button button-secondary" href={link.path}>{lab.code}</a> : <span class="chip chip-amber mono">{lab.code} {lab.status ?? 'planned'}</span>}
          </li>
        );
      })}
    </ul>
  </section>
</Base>
