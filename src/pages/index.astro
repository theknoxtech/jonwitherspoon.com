---
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import site from '../data/site.json';

const { profile } = site;
const featuredProjects = site.projects
  .filter((project) => project.featured)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 3);
const articles = (site.articles ?? []).slice(0, 3);
const oneSentenceIntro = `${profile.intro.split('. ')[0].replace(/\.$/, '')}.`;

const CHIP_TINTS = ['blue', 'teal', 'amber', 'rose'];
function chipTint(label: string): string {
  const total = [...label].reduce((sum, character) => sum + character.charCodeAt(0), 0);
  return CHIP_TINTS[total % CHIP_TINTS.length];
}
---

<Base
  title={`${profile.name} - Systems Administrator and Infrastructure Engineer`}
  description="Jonathan Witherspoon, systems administrator and infrastructure engineer in Knoxville, TN. Career history, projects, and certification study labs."
  path="/"
>
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-text">
      <h1 id="page-title">Hi, I'm {profile.shortName ?? profile.name}</h1>
      <p class="role-line mono">{profile.roleLine}</p>
      <p class="intro">{oneSentenceIntro}</p>
      <div class="button-row">
        <a class="button button-primary" href="/projects/">View projects</a>
        <a class="text-link" href="/portfolio/#about">About me</a>
      </div>
    </div>
    <ProfileCard />
  </section>

  <section class="block" aria-labelledby="articles-heading">
    <h2 id="articles-heading" class="block-heading"><span class="mono">01 /</span> Articles</h2>
    {articles.length === 0 ? (
      <p class="empty-state">Articles are on the way.</p>
    ) : (
      <ul class="card-list card-list-three">
        {articles.map((article) => (
          <li class="article-card">
            <h3>{article.title}</h3>
            {article.date && <p class="meta mono">{article.date}</p>}
            <p>{article.description}</p>
            {(article.tags ?? []).length > 0 && (
              <ul class="chips mono">
                {article.tags.map((tag) => <li class={`chip chip-${chipTint(tag)}`}>{tag}</li>)}
              </ul>
            )}
            <p class="card-action"><a class="text-link" href={article.url}>Read article<span class="visually-hidden">: {article.title}</span></a></p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="block" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="block-heading"><span class="mono">02 /</span> A few projects</h2>
    <ul class="card-list card-list-three">
      {featuredProjects.map((project) => (
        <li class="card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <ul class="chips mono">
            {(project.tags ?? []).map((tag) => <li class={`chip chip-${chipTint(tag)}`}>{tag}</li>)}
          </ul>
          <p class="card-action"><a class="text-link" href={project.url} rel="noopener noreferrer">{project.linkLabel ?? 'Repository'}<span class="visually-hidden"> for {project.title}</span></a></p>
        </li>
      ))}
    </ul>
    <p class="more"><a class="text-link" href="/projects/">All projects</a></p>
  </section>

  <section class="lab-strip" aria-labelledby="labs-heading">
    <h2 id="labs-heading">Study labs</h2>
    <ul class="chips mono">
      {site.labs.map((lab) => {
        const status = lab.status ?? (lab.path ? 'live' : 'planned');
        return <li class={`chip ${status === 'live' ? 'chip-teal' : 'chip-amber'}`}>{lab.code} {status}</li>;
      })}
    </ul>
    <p class="strip-links">
      {site.labs.find((lab) => lab.path) && <a class="text-link" href={site.labs.find((lab) => lab.path).path}>Open {site.labs.find((lab) => lab.path).code}</a>}
      <a class="text-link" href="/labs/">All labs</a>
    </p>
  </section>
</Base>
