---
import site from '../data/site.json';
import { icons } from '../data/icons.js';

interface Props {
  showRole?: boolean;
  extraLinks?: { label: string; href: string }[];
}

const { showRole = false, extraLinks = [] } = Astro.props;
const { profile } = site;
const currentRole = site.experience.find((role) => role.current);
const isPlaceholder = (value: string | undefined): boolean => value?.startsWith('[TO SUPPLY') ?? false;
---

<aside class="profile-card" aria-label="Profile">
  <img class="avatar" src={profile.avatar} width="80" height="80" alt={`Portrait of ${profile.name}`} />
  <div class="profile-text">
    <p class="profile-name">{profile.name}</p>
    {showRole && <p class="role-line mono">{profile.roleLine}</p>}
    <p class="meta">{profile.location}</p>
    {currentRole && (
      <p class="meta">
        Now:{' '}
        {isPlaceholder(currentRole.title) ? <span class="placeholder">{currentRole.title}</span> : currentRole.title},
        {' '}{currentRole.company}
      </p>
    )}
    <ul class="social-links">
      <li><a class="social-link" href={profile.github} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.github} />GitHub</a></li>
      <li><a class="social-link" href={profile.linkedin} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.linkedin} />LinkedIn</a></li>
      {extraLinks.map((link) => <li><a class="social-link" href={link.href} rel="noopener noreferrer">{link.label}</a></li>)}
    </ul>
  </div>
</aside>
