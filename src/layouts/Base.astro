---
import '../styles/site.css';
import site from '../data/site.json';
import { icons } from '../data/icons.js';

interface Props {
  title: string;
  description: string;
  path: string;
  section?: 'portfolio' | 'projects' | 'labs' | 'articles';
  withTabs?: boolean;
}

const { title, description, path, section, withTabs = false } = Astro.props;
const canonicalUrl = `https://jonwitherspoon.com${path}`;
const builtOn = new Date().toISOString().slice(0, 10);
const commit = (process.env.GITHUB_SHA ?? '').slice(0, 7) || 'local';
const navLinks = [
  { label: 'Portfolio', href: '/portfolio/', key: 'portfolio' },
  { label: 'Projects', href: '/projects/', key: 'projects' },
  { label: 'Labs', href: '/labs/', key: 'labs' },
  { label: 'Articles', href: '/articles/', key: 'articles' },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/search.js" defer></script>
    {withTabs && <script is:inline src="/tabs.js" defer></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Main">
        <a class="nav-name" href="/"><span class="monogram" aria-hidden="true">J</span><span class="nav-name-text">{site.profile.name}</span></a>
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li><a href={link.href} aria-current={section === link.key ? 'page' : undefined}>{link.label}</a></li>
          ))}
          <li class="nav-external"><a class="icon-link" href={site.profile.github} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.github} /><span class="visually-hidden">GitHub</span></a></li>
          <li class="nav-external"><a class="icon-link" href={site.profile.linkedin} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.linkedin} /><span class="visually-hidden">LinkedIn</span></a></li>
          <li class="nav-search"><button class="search-trigger" type="button" data-quick-open aria-haspopup="dialog"><span class="icon" aria-hidden="true" set:html={icons.search} /><span class="search-trigger-text">Search</span><kbd class="shortcut mono" data-shortcut>Ctrl K</kbd></button></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-brand"><span class="monogram" aria-hidden="true">J</span> {site.profile.name}</p>
      <nav aria-label="Footer">
        <ul class="footer-list">
          {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
      <ul class="footer-social">
        <li><a class="icon-link" href={site.profile.github} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.github} /><span class="visually-hidden">GitHub</span></a></li>
        <li><a class="icon-link" href={site.profile.linkedin} rel="noopener noreferrer"><span class="icon" aria-hidden="true" set:html={icons.linkedin} /><span class="visually-hidden">LinkedIn</span></a></li>
      </ul>
      <p class="footer-meta mono">&copy; {builtOn.slice(0, 4)} Jon Witherspoon</p>
      <p class="footer-meta mono">built {builtOn} · {commit}</p>
      <p class="footer-meta"><a href="https://siliconscripted.com" rel="noopener noreferrer">Previous site: siliconscripted.com</a></p>
    </footer>
    <dialog class="quick-search" data-quick-dialog aria-label="Search projects and labs">
      <label class="visually-hidden" for="quick-search-input">Search projects and labs</label>
      <input class="search-input" type="search" id="quick-search-input" data-quick-input placeholder="Search projects and labs" autocomplete="off" />
      <ul class="quick-results" data-quick-results></ul>
      <p class="search-count mono" data-quick-status aria-live="polite">Type to search.</p>
      <button class="button button-secondary" type="button" data-quick-close>Close</button>
    </dialog>
  </body>
</html>
